# Local demo credentials only. Change these before exposing services beyond localhost.
POSTGRES_DB=lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_local_only
POSTGRES_PORT=5432

# Ollama is the default provider; Compose pulls this model on first startup.
DEFAULT_MODEL=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m

# Optional cloud fallback. Leave blank for a local-only demo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
